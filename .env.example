# Copy to .env for local dev. All optional — sane defaults exist.
SECRET_KEY=dev-not-secret
# Seconds a built board is cached before recompute (board pulls live data).
BOARD_CACHE_TTL=900
# Rows shown on the leaderboard by default.
LEADERBOARD_LIMIT=50

# --- HR prop odds (the HR ODDS column) ---
# Provider: "actionnetwork" (free public API, no key), "file"
# (read instance/odds/<date>.csv|json), or "theoddsapi" (paid).
ODDS_PROVIDER=actionnetwork
# Action Network book to show. 15 = Consensus (market average). 49 Caesars,
# 69 FanDuel, 30 Open.
AN_BOOK_ID=15
# The Odds API (only if ODDS_PROVIDER=theoddsapi). Player props need a paid
# Business plan. Get a key at https://the-odds-api.com/
ODDS_API_KEY=
ODDS_API_REGIONS=us
# Optional: restrict to one book by its Odds-API key (e.g. draftkings).
ODDS_API_BOOKMAKER=
