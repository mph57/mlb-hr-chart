# Copy to .env for local dev. All optional — sane defaults exist.
SECRET_KEY=dev-not-secret
# Seconds a built board is cached before recompute (board pulls live data).
BOARD_CACHE_TTL=900
# Rows shown on the leaderboard by default.
LEADERBOARD_LIMIT=50

# --- HR prop odds / edge ---
# Provider: "actionnetwork" (free public API, no key), "file"
# (read instance/odds/<date>.csv|json), or "theoddsapi" (paid).
ODDS_PROVIDER=actionnetwork
# Action Network book id to price against. 15 = Consensus (has both sides, so
# we can de-vig). Others: 49 Caesars, 69 FanDuel, 30 Open.
AN_BOOK_ID=15
# Don't flag VALUE on prices longer than this — the model over-projects deep
# longshots a sharp market prices far lower (edge still shown, just no badge).
VALUE_MAX_ODDS=600
# The Odds API (only if ODDS_PROVIDER=theoddsapi). Player props need a paid
# Business plan. Get a key at https://the-odds-api.com/
ODDS_API_KEY=
ODDS_API_REGIONS=us
# Optional: restrict to one book by its Odds-API key (e.g. draftkings).
ODDS_API_BOOKMAKER=
# When only an Over price is known (no Under to de-vig), require at least this
# model-vs-market edge in percentage points before flagging a bet as VALUE.
VALUE_THRESHOLD_PP=3.0
